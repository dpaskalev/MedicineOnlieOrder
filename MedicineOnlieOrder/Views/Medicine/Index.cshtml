@model IEnumerable<MedicineOnlieOrder.VewModels.MedicineIndexViewModel>

<h2>All Medicine</h2>

<table class="table table-striped">
    <thead>
        <tr>MedicineName</tr>
        <tr>MedicineType</tr>
        <tr>ExperationDate</tr>
        <tr>Price</tr>
        <tr>Description</tr>
    </thead>
    <tbody>
        @foreach (var medicine in Model)
        {
            <partial name="_MedicineIndexPartial" model="medicine" />
        }
    </tbody>
</table>
<a asp-action="Create" class="btn btn-primary">Add new medicine</a>
<a asp-action="Search" class="btn btn-primary">Search</a>