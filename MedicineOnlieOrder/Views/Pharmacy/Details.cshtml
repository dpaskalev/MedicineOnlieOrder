@model Services.VewModels.PharmacyDetailsViewModel

<h2>@Model.Name</h2>

<p><strong>Location:</strong> @Model.Location</p>

<h3>Has medicines: </h3>

@if (Model.Medicines.Any())
{
    <partial name="_PharmacyDetailsPartial" model="Model" />
}
else
{
    <p>No medicine in this pharmacy</p>
}

<a asp-action="Index" class="btn btn-secondary mt-3">Back to all pharmacies</a>